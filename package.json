{
  "name": "hospitality-pos",
  "version": "0.1.0",
  "private": true,
  "description": "Single-outlet Restaurant + Bar + Room-Service POS with shared inventory",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @pos/db generate",
    "db:migrate": "pnpm --filter @pos/db migrate",
    "db:deploy": "pnpm --filter @pos/db deploy",
    "db:seed": "pnpm --filter @pos/db seed",
    "db:reset": "pnpm --filter @pos/db reset",
    "db:studio": "pnpm --filter @pos/db studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:seed": "docker compose run --rm -e FORCE_SEED=1 migrate node packages/db/scripts/seed-if-empty.mjs",
    "till": "pnpm --filter @pos/till launch",
    "till:build": "pnpm --filter @pos/till build",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
