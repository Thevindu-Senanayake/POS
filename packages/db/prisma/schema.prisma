// Hospitality POS — Prisma schema
// Maps the domain model in POS_SYSTEM_INSTRUCTIONS.md §2.
// Conventions: PascalCase models -> snake_case tables (@@map); columns camelCase.
// Money => Decimal(12,2); stock quantities => Decimal(14,3); costs => Decimal(14,4).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  cashier
  waiter
  bartender
  kitchen_staff
  room_service_staff
}

enum BaseUnit {
  g
  ml
  pcs
}

enum IngredientDepartment {
  bar
  restaurant
}

enum StockReason {
  purchase
  sale
  wastage
  adjustment
  return
}

enum StockRefType {
  order_item
  purchase_order
  manual
}

enum PurchaseOrderStatus {
  draft
  received
}

enum MenuCategory {
  food
  bar
  room_service
}

enum Station {
  kitchen
  bar
}

enum Channel {
  dine_in_restaurant
  dine_in_bar
  takeaway
  room_service
}

enum OrderStatus {
  draft
  sent_to_kitchen
  served
  bill_requested
  paid
  cancelled
}

enum OrderItemStatus {
  draft
  sent_to_kitchen
  served
  cancelled
}

enum TableArea {
  restaurant
  bar
}

enum TableStatus {
  free
  occupied
  reserved
  needs_cleaning
}

enum RoomStatus {
  vacant
  occupied
  maintenance
}

enum BoardPlan {
  room_only
  bed_breakfast
  half_board
  full_board
}

enum BookingStatus {
  reserved
  checked_in
  checked_out
  cancelled
}

enum FolioSource {
  room_service_order
  restaurant_order
  bar_order
  room_rate
  misc
}

enum PaymentMethod {
  cash
  card
  charge_to_room
}

enum PrintJobType {
  kot
  bill
}

enum PrintJobStatus {
  pending
  printing
  done
  failed
}

enum DiscountType {
  percentage
  flat
}

enum DiscountScope {
  order
  line
}

enum AuditAction {
  void_order
  void_item
  cancel_order
  discount_applied
  price_override
  split_bill
  merge_table
  transfer_table
  pin_override
  goods_received
}

// Which physical printer a job routes to (spec §3.2). `receipt` is the
// station-less customer bill/receipt printer; `kitchen`/`bar` are the KOTs.
enum PrinterRole {
  kitchen
  bar
  receipt
}

// How the agent reaches a printer: `network` = TCP (ip:port), `usb` = the
// host OS spooler / installed printer addressed by name (`device`).
enum PrinterConnection {
  network
  usb
}

// ---------------------------------------------------------------------------
// Tenancy / users
// ---------------------------------------------------------------------------

// Single outlet for now; outletId is a nullable FK on core tables so a second
// location can be added later without a schema rewrite (spec §0.1).
model Outlet {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  // Receipt header/footer customisation (spec: owner-editable bill). Each text
  // line pairs with a `show*` toggle so the owner can print or hide it per line.
  tagline              String?
  taxNumber            String?
  receiptFooter        String?  @default("Thank you!")
  receiptCurrencyLabel String?  @default("Rs.")
  showName             Boolean  @default(true)
  showTagline          Boolean  @default(false)
  showAddress          Boolean  @default(true)
  showPhone            Boolean  @default(true)
  showTaxNumber        Boolean  @default(false)
  showFooter           Boolean  @default(true)
  showCurrencyLabel    Boolean  @default(true)
  createdAt DateTime @default(now())

  users         User[]
  ingredients   Ingredient[]
  menuItems     MenuItem[]
  diningTables  DiningTable[]
  orders        Order[]
  rooms         Room[]
  purchaseOrders PurchaseOrder[]

  @@map("outlets")
}

model User {
  id           String   @id @default(cuid())
  outletId     String?
  outlet       Outlet?  @relation(fields: [outletId], references: [id])
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole
  pinHash      String? // manager/admin PIN for override actions (spec §7)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ordersCreated  Order[]         @relation("OrderCreatedBy")
  sessions       TableSession[]  @relation("SessionWaiter")
  paymentsTaken  Payment[]       @relation("PaymentTakenBy")
  auditActor     AuditLog[]      @relation("AuditActor")
  auditApprover  AuditLog[]      @relation("AuditApprover")
  refreshTokens  RefreshToken[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Inventory (spec §2.1)
// ---------------------------------------------------------------------------

model Ingredient {
  id           String   @id @default(cuid())
  outletId     String?
  outlet       Outlet?  @relation(fields: [outletId], references: [id])
  name         String
  baseUnit     BaseUnit
  // Bar stock (spirits, wine, mixers) vs restaurant raw materials. Splits the
  // inventory screen; back-filled from baseUnit/barcode for pre-existing rows.
  department   IngredientDepartment @default(restaurant)
  // Barcode of the physical stock unit (e.g. a spirit bottle). A bar scan that
  // matches this resolves to the pour MenuItems built from this ingredient.
  barcode      String?  @unique
  // Derived from the stock_movements ledger; kept in sync only inside the same
  // DB transaction that appends the movement, never mutated standalone (spec §2.1).
  currentStock Decimal  @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal  @default(0) @db.Decimal(14, 3)
  costPerUnit  Decimal  @default(0) @db.Decimal(14, 4) // weighted average
  supplierId   String?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stockMovements     StockMovement[]
  recipes            Recipe[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([outletId])
  @@index([department])
  @@map("ingredients")
}

// Append-only ledger — the source of truth for stock (spec §2.1).
model StockMovement {
  id             String       @id @default(cuid())
  ingredientId   String
  ingredient     Ingredient   @relation(fields: [ingredientId], references: [id])
  changeQty      Decimal      @db.Decimal(14, 3) // +/- in base unit
  reason         StockReason
  refType        StockRefType
  refId          String?
  unitCostAtTime Decimal?     @db.Decimal(14, 4)
  note           String?
  createdById    String?
  createdAt      DateTime     @default(now())

  @@index([ingredientId, createdAt])
  @@index([reason, createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Purchasing / goods receiving (spec §2.2)
// ---------------------------------------------------------------------------

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactInfo String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients    Ingredient[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  outletId    String?
  outlet      Outlet?             @relation(fields: [outletId], references: [id])
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(draft)
  reference   String?
  orderedAt   DateTime            @default(now())
  receivedAt  DateTime?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  qty             Decimal       @db.Decimal(14, 3) // base unit
  unitCost        Decimal       @db.Decimal(14, 4)
  batchRef        String?

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Menu, pricing, recipes (spec §2.3, §2.4)
// ---------------------------------------------------------------------------

model MenuItem {
  id        String       @id @default(cuid())
  outletId  String?
  outlet    Outlet?      @relation(fields: [outletId], references: [id])
  name      String
  category  MenuCategory
  // Fine-grained menu section from the source catalog (e.g. "ARRACK", "Fried
  // Rice"). `category` remains the coarse KOT-routing bucket; `menuGroup` is for
  // grouping/filtering the POS grid and reports.
  menuGroup String?
  // Scannable barcode for whole-unit, direct-sale bar items (bottled beer, cans).
  // Spirits sold by pour carry the barcode on their bottle Ingredient instead.
  barcode   String?      @unique
  station   Station // KOT routing (spec §2.4)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  prices     MenuItemPrice[]
  recipes    Recipe[]
  orderItems OrderItem[]

  @@index([outletId])
  @@index([category])
  @@map("menu_items")
}

// Channel-aware, portion-aware pricing. Each portion size is its own MenuItem,
// so there is no formula linking e.g. Whisky Single and Whisky Double (spec §2.4).
model MenuItemPrice {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  channel    Channel
  price      Decimal  @db.Decimal(12, 2)

  @@unique([menuItemId, channel])
  @@map("menu_item_prices")
}

// Bill of Materials (spec §2.3).
model Recipe {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(14, 3) // in ingredient base unit
  notes        String?

  @@unique([menuItemId, ingredientId])
  @@map("recipes")
}

// Service charge by channel (spec §2.5). No tax layer.
model ServiceChargeRule {
  id         String   @id @default(cuid())
  channel    Channel  @unique
  percentage Decimal  @db.Decimal(5, 2) // e.g. 10.00 = 10%
  updatedAt  DateTime @updatedAt

  @@map("service_charge_rules")
}

// ---------------------------------------------------------------------------
// Tables & order lifecycle (spec §2.6)
// ---------------------------------------------------------------------------

model DiningTable {
  id        String      @id @default(cuid())
  outletId  String?
  outlet    Outlet?     @relation(fields: [outletId], references: [id])
  area      TableArea
  name      String
  capacity  Int         @default(2)
  status    TableStatus @default(free)
  createdAt DateTime    @default(now())

  sessions TableSession[]

  @@index([outletId])
  @@map("dining_tables")
}

model TableSession {
  id       String      @id @default(cuid())
  tableId  String
  table    DiningTable @relation(fields: [tableId], references: [id])
  waiterId String?
  waiter   User?       @relation("SessionWaiter", fields: [waiterId], references: [id])
  openedAt DateTime    @default(now())
  closedAt DateTime?

  orders Order[]

  @@index([tableId])
  @@map("table_sessions")
}

model Order {
  id             String        @id @default(cuid())
  outletId       String?
  outlet         Outlet?       @relation(fields: [outletId], references: [id])
  channel        Channel
  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])
  bookingId      String?
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  status         OrderStatus   @default(draft)
  notes          String?
  createdById    String?
  createdBy      User?         @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items        OrderItem[]
  payments     Payment[]
  discounts    Discount[]
  bills        Bill[]
  folioCharges FolioCharge[]

  @@index([status])
  @@index([tableSessionId])
  @@index([bookingId])
  @@index([channel, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem        @relation(fields: [menuItemId], references: [id])
  qty        Int
  unitPrice  Decimal         @db.Decimal(12, 2) // snapshot at order time (spec §2.6)
  station    Station
  status     OrderItemStatus @default(draft)
  notes      String?
  sentAt     DateTime?
  servedAt   DateTime?
  createdAt  DateTime        @default(now())

  discounts Discount[]
  billItems BillItem[]

  @@index([orderId])
  @@index([status])
  @@map("order_items")
}

// A (sub-)bill against an order. A non-split order settles as a single Bill;
// a split produces N bills, all against the same parent order (spec §2.6).
model Bill {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id])
  label         String?
  subtotal      Decimal  @db.Decimal(12, 2)
  discountTotal Decimal  @default(0) @db.Decimal(12, 2)
  serviceCharge Decimal  @default(0) @db.Decimal(12, 2)
  total         Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  items    BillItem[]
  payments Payment[]

  @@index([orderId])
  @@map("bills")
}

model BillItem {
  id          String     @id @default(cuid())
  billId      String
  bill        Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  description String
  qty         Decimal    @db.Decimal(12, 3)
  unitPrice   Decimal    @db.Decimal(12, 2)
  lineTotal   Decimal    @db.Decimal(12, 2)

  @@index([billId])
  @@map("bill_items")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  billId    String?
  bill      Bill?         @relation(fields: [billId], references: [id])
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  // Physical cash handed over for a cash tender; change = tendered − amount is
  // derived, not stored. Null for card and for legacy rows (spec: cash change).
  tendered  Decimal?      @db.Decimal(12, 2)
  reference String?
  takenById String?
  takenBy   User?         @relation("PaymentTakenBy", fields: [takenById], references: [id])
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([method, createdAt])
  @@map("payments")
}

// Order- or line-level discount (spec §8). Manager-PIN when applied by non-admin;
// the approval is also written to the AuditLog.
model Discount {
  id           String        @id @default(cuid())
  scope        DiscountScope
  type         DiscountType
  value        Decimal       @db.Decimal(12, 2) // percent or flat amount entered
  amount       Decimal       @db.Decimal(12, 2) // resolved applied amount
  reason       String?
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id])
  orderItemId  String?
  orderItem    OrderItem?    @relation(fields: [orderItemId], references: [id])
  approvedById String?
  createdById  String?
  createdAt    DateTime      @default(now())

  @@index([orderId])
  @@map("discounts")
}

// ---------------------------------------------------------------------------
// Rooms & folio (spec §2.7)
// ---------------------------------------------------------------------------

model RoomCategory {
  id          String   @id @default(cuid())
  name        String
  defaultRate Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]

  @@map("room_categories")
}

model Room {
  id             String       @id @default(cuid())
  outletId       String?
  outlet         Outlet?      @relation(fields: [outletId], references: [id])
  roomNumber     String       @unique
  roomCategoryId String
  roomCategory   RoomCategory @relation(fields: [roomCategoryId], references: [id])
  rateOverride   Decimal?     @db.Decimal(12, 2) // overrides category default for this room (spec §2.7)
  status         RoomStatus   @default(vacant)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  bookings Booking[]

  @@index([outletId])
  @@map("rooms")
}

model Booking {
  id          String        @id @default(cuid())
  roomId      String
  room        Room          @relation(fields: [roomId], references: [id])
  guestName   String
  guestPhone  String?
  checkIn     DateTime
  checkOut    DateTime
  boardPlan   BoardPlan     @default(room_only)
  agreedRate  Decimal       @db.Decimal(12, 2) // snapshot of effective rate at booking time (spec §2.7)
  status      BookingStatus @default(reserved)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  folioCharges FolioCharge[]
  orders       Order[]

  @@index([roomId])
  @@index([status])
  @@map("bookings")
}

model FolioCharge {
  id          String      @id @default(cuid())
  bookingId   String
  booking     Booking     @relation(fields: [bookingId], references: [id])
  source      FolioSource
  refId       String?
  orderId     String?
  order       Order?      @relation(fields: [orderId], references: [id])
  description String?
  amount      Decimal     @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime    @default(now())

  @@index([bookingId])
  @@map("folio_charges")
}

// ---------------------------------------------------------------------------
// Printing (spec §3) — the queue the print-agent polls.
// ---------------------------------------------------------------------------

model PrintJob {
  id            String         @id @default(cuid())
  type          PrintJobType
  station       Station? // KOT routing; null for bills
  payload       Json // rendered content model
  status        PrintJobStatus @default(pending)
  attempts      Int            @default(0)
  maxAttempts   Int            @default(6)
  lastError     String?
  nextAttemptAt DateTime       @default(now())
  orderId       String?
  billId        String?
  claimedBy     String?
  claimedAt     DateTime?
  printedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@map("print_jobs")
}

// Printer registry + health (spec §3.2 config mapping, §3.3 health banner).
model Printer {
  id         String            @id @default(cuid())
  role       PrinterRole       @unique
  name       String
  connection PrinterConnection @default(network)
  ip         String? // network: printer IP
  port       Int               @default(9100)
  device     String? // usb: OS spooler / installed-printer name
  type       String            @default("epson")
  online     Boolean           @default(true)
  lastSeenAt DateTime?
  lastError  String?
  updatedAt  DateTime          @updatedAt

  @@map("printers")
}

// ---------------------------------------------------------------------------
// Audit & settings
// ---------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String?
  reason     String?
  metadata   Json?
  actorId    String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id])
  approverId String? // manager who authorised via PIN
  approver   User?       @relation("AuditApprover", fields: [approverId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}
