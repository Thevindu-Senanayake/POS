# ---------------------------------------------------------------------------
# Copy to .env at the repo root:  cp .env.example .env
# The same file is read by all workspaces (loaded via dotenv / Next.js).
# ---------------------------------------------------------------------------

# --- Database (matches docker-compose.yml; host port 5433 to avoid clashing with a native Postgres) ---
# Use 127.0.0.1 (not "localhost") so Node/Prisma don't resolve to IPv6 ::1, which Docker doesn't forward.
DATABASE_URL="postgresql://pos:pos@127.0.0.1:5433/pos?schema=public"

# --- API (apps/api) ---
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Shared secret the print-agent uses to authenticate to the API.
PRINT_AGENT_TOKEN="dev-print-agent-token-change-me"
# Default currency symbol used on bills/receipts.
CURRENCY_SYMBOL="₨"

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# --- Print agent (apps/print-agent) ---
PRINT_AGENT_API_URL="http://localhost:4000"
PRINT_AGENT_POLL_MS=2000
PRINT_AGENT_MAX_RETRIES=6
# Printer mapping per ROLE (kitchen/bar = KOTs; receipt = the customer bill).
# The DB printer map is the source of truth; these env vars override it per role so
# you can point at real hardware without editing the DB. Any override left blank
# falls back to the DB value (and ultimately to stdout rendering — the zero-hardware
# dev path, so `pnpm dev` prints to the console out of the box).
#
#   CONNECTION = network → print over TCP to IP:PORT   (kitchen/bar KOT printers)
#   CONNECTION = usb     → print via the host OS spooler to the printer named DEVICE
#                          (the customer bill/receipt printer on the till PC)
#
# The USB path needs the optional native module `@thiagoelg/node-printer` built on
# the till host; if it's absent the agent degrades to stdout instead of crashing.
PRINTER_KITCHEN_CONNECTION="network"
PRINTER_KITCHEN_TYPE="epson"
PRINTER_KITCHEN_IP=""
PRINTER_KITCHEN_PORT=9100
PRINTER_BAR_CONNECTION="network"
PRINTER_BAR_TYPE="epson"
PRINTER_BAR_IP=""
PRINTER_BAR_PORT=9100
# `receipt` targets station-less bill/receipt jobs. On the till PC set it to the USB
# printer; leave CONNECTION/DEVICE blank in dev to render receipts to stdout.
PRINTER_RECEIPT_CONNECTION="usb"
PRINTER_RECEIPT_TYPE="epson"
# Windows/OS printer name (as it appears in the OS printer list), e.g. "Receipt Printer".
PRINTER_RECEIPT_DEVICE=""

# --- Print agent: optional tuning (sensible defaults shown; uncomment to override) ---
# PRINT_AGENT_ID="print-agent@this-host"        # identifies this agent when claiming jobs
# PRINT_AGENT_CLAIM_LIMIT=10                     # max jobs claimed per poll
# PRINT_AGENT_PRINTER_REFRESH_MS=30000           # how often the printer map is re-read
# PRINT_AGENT_CONNECT_TIMEOUT_MS=5000            # per-printer TCP connect timeout
