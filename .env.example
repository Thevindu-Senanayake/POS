# ---------------------------------------------------------------------------
# Copy to .env at the repo root:  cp .env.example .env
# The same file is read by all workspaces (loaded via dotenv / Next.js) and by
# docker compose (dev: docker-compose.yml, prod: docker-compose.prod.yml).
# ---------------------------------------------------------------------------

# --- Database (matches docker-compose.yml; host port 5433 to avoid clashing with a native Postgres) ---
# Use 127.0.0.1 (not "localhost") so Node/Prisma don't resolve to IPv6 ::1, which Docker doesn't forward.
DATABASE_URL="postgresql://pos:pos@127.0.0.1:5433/pos?schema=public"
# Credentials for the compose `db` service (interpolated with these defaults).
# Change them for a real deployment and keep DATABASE_URL in sync.
POSTGRES_USER="pos"
POSTGRES_PASSWORD="pos"
POSTGRES_DB="pos"

# --- API (apps/api) ---
API_PORT=4000
# The browser origin the API allows via CORS. Must EXACTLY match where the web UI
# is served from:
#   dev / `next start`          -> http://localhost:3000
#   prod / nginx static on :80  -> http://<droplet-ip>      (NO port suffix)
CORS_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# Shared secret the Electron till (its in-process print host) uses to authenticate
# to the API's print-job queue. The till must send the SAME value.
PRINT_AGENT_TOKEN="dev-print-agent-token-change-me"
# Default currency symbol used on bills/receipts.
CURRENCY_SYMBOL="₨"

# --- Web (apps/web) — inlined into the bundle at BUILD time (Docker build args) ---
# Point at the host-published API port. In prod these are set as GitHub Actions
# variables and baked into the web image, e.g. http://<droplet-ip>:4000.
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# --- Electron till print host (apps/till) ---
# The till polls the API's print-job queue and prints through the Windows driver
# (webContents.print) — there is no standalone ESC/POS agent anymore, and printer
# selection lives on the till (userData/printers.json), not in env vars.
PRINT_AGENT_API_URL="http://localhost:4000"
PRINT_AGENT_POLL_MS=2000
PRINT_AGENT_MAX_RETRIES=6

# --- Till print host: optional tuning (defaults shown; uncomment to override) ---
# PRINT_AGENT_ID="till@this-host"    # identifies this till when claiming jobs
# PRINT_AGENT_CLAIM_LIMIT=10         # max jobs claimed per poll
