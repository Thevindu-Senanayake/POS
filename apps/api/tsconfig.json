{
  "extends": "@pos/tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "types": ["node"],
    // Disabled: incremental + nest's deleteOutDir leaves a stale tsbuildinfo that
    // skips re-emitting unchanged entrypoints (e.g. main.js) after dist is wiped.
    "incremental": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
