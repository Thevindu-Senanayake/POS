{
  "name": "@pos/print-agent",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pos/shared": "workspace:*",
    "node-thermal-printer": "^4.4.4"
  },
  "devDependencies": {
    "@pos/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "dotenv-cli": "^7.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
